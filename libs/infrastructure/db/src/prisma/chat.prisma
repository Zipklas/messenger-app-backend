model Chat {
  id        String    @id @default(uuid())
  type      ChatType  @default(DIRECT)
  name      String?
  avatar    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members  ChatMember[]
  messages Message[]

  @@map("chats")
}
